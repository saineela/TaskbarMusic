<Window x:Class="TaskbarMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="TaskbarMusic"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="500" Height="50"
        ResizeMode="NoResize"
        Left="800" Top="1140"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="TaskbarMusic"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🎤 Show/Hide Lyrics" Click="TrayShowHide_Click"/>
                    <Separator/>
                    <MenuItem Header="🚀 Run on Startup" IsCheckable="True" IsChecked="False" x:Name="StartupMenuItem" Click="TrayStartup_Click"/>
                    <Separator/>
                    <MenuItem Header="❌ Exit" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Plain text lyrics indicator (top-left orange bubble) -->
        <Border x:Name="PlainTextIndicator"
                Background="#FFF3CD"
                BorderBrush="#FF9800"
                BorderThickness="1.5"
                CornerRadius="5"
                Padding="6,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="2,2,0,0"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF9800" Opacity="0.55"/>
            </Border.Effect>
            <TextBlock Text="🟠 Plain Lyrics"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#BF360C"
                       FontFamily="Segoe UI"
                       ToolTip="These lyrics have artificial timing. Right-click → Tune Lyrics to sync them manually."/>
        </Border>

        <!-- Floating lyrics text -->
        <Border x:Name="HitArea"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="Left-click: Drag | Double-click: Lock/Unlock | Right-click: Menu">
            <Grid>
                <!-- Normal lyrics display -->
                <Grid x:Name="NormalDisplay">
                    <TextBlock x:Name="StatusText"
                           Text="♪ TaskbarMusic — Drag me anywhere, double-click to lock"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <!-- WebSocket connection indicator (hidden) -->
                    <Ellipse x:Name="ConnectionIndicator"
                             Width="8" Height="8"
                             Fill="#555555"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,4,0"
                             Visibility="Collapsed">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <!-- Tuning mode display (hidden until user clicks Tune Lyrics) -->
                <Grid x:Name="TuningDisplay" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tuning status + current line -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,4,0">
                        <TextBlock x:Name="TuningProgressText"
                                   Text="🎵 Tuning: Line 1/20"
                                   FontSize="10"
                                   Foreground="#FFB74D"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TuningLineText"
                                   Text="..."
                                   FontSize="14"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Tap button -->
                    <Button x:Name="TuningTapButton"
                            Grid.Column="1"
                            Content="⏎ TAP"
                            Width="70" Height="38"
                            FontSize="13" FontWeight="Bold"
                            FontFamily="Segoe UI"
                            Foreground="White"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FF6F00"
                                        CornerRadius="6"
                                        BorderThickness="0"
                                        Padding="6,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cancel tuning button -->
                    <Button x:Name="TuningCancelButton"
                            Grid.Column="2"
                            Content="✕"
                            Width="28" Height="28"
                            FontSize="12" FontWeight="Bold"
                            FontFamily="Segoe UI"
                            Foreground="White"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="Cancel tuning (Esc)"
                            Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#555555"
                                        CornerRadius="5"
                                        BorderThickness="0"
                                        Padding="4,2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
